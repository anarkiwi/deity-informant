+static const char *expr_opname(int op)
+{
+    switch(op)
+    {
+    case PLUS: return "+";
+    case MINUS: return "-";
+    case MULT: return "*";
+    case DIV: return "/";
+    case MOD: return "%";
+    case LT: return "<";
+    case GT: return ">";
+    case EQ: return "==";
+    case NEQ: return "!=";
+    case LOR: return "||";
+    case LAND: return "&&";
+    case vNEG: return "neg";
+    case LNOT: return "!";
+    }
+    return "?";
+}
+
+static void expr_json(FILE *f, struct expr *e)
+{
+    switch(e->expr_op)
+    {
+    case NUMBER:
+        fprintf(f, "%d", e->type.number);
+        break;
+    case SYMBOL:
+        fprintf(f, "\"%s\"", e->type.symref);
+        break;
+    case vNEG:
+    case LNOT:
+        fprintf(f, "[\"%s\",", expr_opname(e->expr_op));
+        expr_json(f, e->type.arg1);
+        fprintf(f, "]");
+        break;
+    default:
+        fprintf(f, "[\"%s\",", expr_opname(e->expr_op));
+        expr_json(f, e->type.arg1);
+        fprintf(f, ",");
+        expr_json(f, e->expr_arg2);
+        fprintf(f, "]");
+    }
+}
+
+static void atom_json(FILE *f, struct atom *atom, int offset)
+{
+    struct vec_iterator i[1];
+    struct expr **exprp;
+    const char *sep = "";
+
+    fprintf(f, "{\"off\":%d,\"type\":%d", offset, atom->type);
+    switch(atom->type)
+    {
+    case ATOM_TYPE_OP_ARG_NONE:
+        fprintf(f, ",\"op\":%d", atom->u.op.code);
+        break;
+    case ATOM_TYPE_OP_ARG_U8:
+    case ATOM_TYPE_OP_ARG_I8:
+    case ATOM_TYPE_OP_ARG_UI8:
+    case ATOM_TYPE_OP_ARG_U16:
+        fprintf(f, ",\"op\":%d,\"arg\":", atom->u.op.code);
+        expr_json(f, atom->u.op.arg);
+        break;
+    case ATOM_TYPE_RES:
+        fprintf(f, ",\"res\":");
+        expr_json(f, atom->u.res.value);
+        break;
+    case ATOM_TYPE_WORD_EXPRS:
+    case ATOM_TYPE_BYTE_EXPRS:
+        fprintf(f, ",\"exprs\":[");
+        vec_get_iterator(atom->u.exprs, i);
+        while((exprp = vec_iterator_next(i)) != NULL)
+        {
+            fprintf(f, "%s", sep);
+            expr_json(f, *exprp);
+            sep = ",";
+        }
+        fprintf(f, "]");
+        break;
+    }
+}
+
+static void symbols_json(FILE *f)
+{
+    struct vec_iterator i[1];
+    struct sym_entry *se;
+    i32 value;
+
+    vec_get_iterator(s_sym_table, i);
+    while((se = vec_iterator_next(i)) != NULL)
+    {
+        if(se->expr != NULL && resolve_expr2(se->expr, &value) == NULL)
+        {
+            fprintf(f, "{\"sym\":\"%s\",\"value\":%d,\"label\":%d}\n",
+                    se->symbol, value, se->label);
+        }
+    }
+}
